# ===========================
# Django Environment Configuration
# ===========================
# Copy this file to .env and update with your values
# DO NOT commit .env to version control

# ===========================
# Django Settings
# ===========================
DJANGO_ENVIRONMENT=local
DEBUG=True
SECRET_KEY=

# Allowed hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1,*.local

# Business local time for hours-gated features
# REUSE: used by contacts.services.is_ordering_open()
BUSINESS_TIME_ZONE=Africa/Cairo

# ===========================
# Database (PostgreSQL)
# ===========================
DB_ENGINE=django.db.backends.postgresql
DB_NAME=project_db
DB_USER=project_user
DB_PASSWORD=password123
DB_HOST=db
DB_PORT=5432

# ===========================
# Redis Cache & Message Broker
# ===========================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_password
REDIS_URL=redis://:redis_password@redis:6379/0
CACHE_URL=redis://:redis_password@redis:6379/1

# ===========================
# Celery Configuration
# ===========================
CELERY_BROKER_URL=redis://:redis_password@redis:6379/0
CELERY_RESULT_BACKEND=redis://:redis_password@redis:6379/0
CELERY_TIMEZONE=UTC
CELERY_TASK_TRACK_STARTED=True
CELERY_TASK_TIME_LIMIT=1800

# ===========================
# JWT Authentication
# ===========================
# REUSE: dedicated JWT key — falls back to SECRET_KEY if empty
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256

# ===========================
# Email Configuration
# ===========================
# For local development use console backend
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# For production use SMTP
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=email@gmail.com
EMAIL_HOST_PASSWORD=password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=email@gmail.com

# ===========================
# OAuth / Social Login
# REUSE: Uncomment + set when using social login (allauth)
# Wire: SOCIALACCOUNT_ADAPTER = "accounts.auth.adapters.SocialAccountAdapter"
# ===========================
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# FACEBOOK_OAUTH_CLIENT_ID=
# FACEBOOK_OAUTH_CLIENT_SECRET=

# ===========================
# Firebase (FCM Push)
# REUSE: Uncomment when using notifications app
# ===========================
# GOOGLE_APPLICATION_CREDENTIALS=./firebase-adminsdk.json

# ===========================
# Security Settings
# ===========================
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0

# ===========================
# Logging
# ===========================
LOG_LEVEL=INFO

# ===========================
# CORS Configuration
# ===========================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000
CORS_ALLOWED_HEADERS=*
CORS_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000

# ===========================
# Domain (for prod nginx / certbot)
# REUSE: set in production .env
# ===========================
# DOMAIN=example.com

# ===========================
# Monitoring & Error Tracking
# ===========================
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project

# ===========================
# Flower (Celery Monitoring)
# ===========================
FLOWER_USER=admin
FLOWER_PASSWORD=admin123

# ===========================
# Docker/Container Settings
# ===========================
DOCKER_ENVIRONMENT=local

# ===========================
# Admin User
# ===========================
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=admin123
LOGIN_USERNAME=
LOGIN_PASSWORD=

# ===========================
# API Documentation
# ===========================
API_TITLE=Django Rapido V2.0
API_DESCRIPTION=Modern Django REST API
API_VERSION=1.0.0

# ===========================
# Testing Configuration
# ===========================
# REUSE: TESTING=True enables SQLite + eager Celery; auto-detected via sys.argv too
TESTING=True

# ===========================
# i18n (modeltranslation)
# REUSE: en/ar support — requires modeltranslation in INSTALLED_APPS
# ===========================
# MODELTRANSLATION_DEFAULT_LANGUAGE=en handled in settings/base.py
